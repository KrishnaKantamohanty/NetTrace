# NetTrace Environment Configuration
PROJECT_NAME="NetTrace CDR Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="generate-secure-random-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=cdr_forensics
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/cdr_forensics
# Set USE_SQLITE_FALLBACK=true to use local sqlite when Postgres is not running
USE_SQLITE_FALLBACK=true

# Neo4j Graph DB Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
# When false, in-memory NetworkX engine runs automatically without interruption
USE_NEO4J=false

# Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=104857600

# Server Ports
BACKEND_PORT=8001
FRONTEND_PORT=3000
