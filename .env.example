# NetTrace Environment Configuration
PROJECT_NAME="NetTrace CDR Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-cdr-forensics"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cdr_forensics
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdr_forensics
# Set USE_SQLITE_FALLBACK=true to use local sqlite when Postgres is not running
USE_SQLITE_FALLBACK=true

# Neo4j Graph DB Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
# If Neo4j is offline, in-memory NetworkX engine runs automatically without interruption
USE_NEO4J=false

# Mapbox / Leaflet Config (Optional for Mapbox tiles)
MAPBOX_ACCESS_TOKEN=""

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
